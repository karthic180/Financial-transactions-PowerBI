model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	maxParallelismPerRefresh: 1
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["transactions_data","users_data","cards_data"]

annotation PBI_ProTooling = ["DevMode"]

ref table transactions_data
ref table users_data
ref table cards_data
ref table 'Date Table'

ref cultureInfo en-GB

