	column 'Month Year' =
			
			FORMAT('Date Table'[Date],"MMM YYYY")
		lineageTag: fbe47f57-3d65-4e83-b14c-39463e4e1f05
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Date Table' = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2020,1,1), DATE(2030,12,31)),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Year Month", FORMAT([Date], "YYYY-MM"),
				    "Week Number", WEEKNUM([Date]),
				    "Day", DAY([Date]),
				    "Day Name", FORMAT([Date], "dddd"),
				    "Day Short", FORMAT([Date], "ddd"),
				    "Weekday Number", WEEKDAY([Date], 2),
				    "Is Weekend", IF(WEEKDAY([Date],2) > 5, "Yes", "No")
				)

	annotation PBI_Id = 5d2e114c6c0c46f09c511fcf72d9d66f

